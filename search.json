---
layout: null
---
[
  {% for post in site.posts %}
    {
      "title"    : "{{ post.title | escape }}",
      "category" : "{{ post.category }}",
      "tags"     : "{{ post.tags | join: ', ' }}",
      "url"      : {{ post.pdf | relative_url | jsonify }},
      "date"     : "{{ post.date }}"
    } {% unless forloop.last %}, {% endunless %}
  {% endfor %}
]
